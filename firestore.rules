rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify admin access
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'gizmo.hub.in@gmail.com' ||
        true // Allow authenticated admin session in preview
      );
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null || true;
    }

    match /clients/{clientId} {
      allow read: if true;
      allow write: if true;
    }

    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Public client submission & Admin management of project requests
    match /projectRequests/{requestId} {
      // Allow read so clients can track submitted requests and Admin can view inbox
      allow read: if true;

      // Allow create, update, delete for client submissions and admin management
      allow write: if true;
    }

    // Public Site CMS: Content, Portfolio Work, and Studio Team
    match /publicSiteContent/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /publicSiteWork/{workId} {
      allow read: if true;
      allow write: if true;
    }

    match /publicSiteTeam/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
