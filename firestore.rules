rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify admin access
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'gizmo.hub.in@gmail.com' ||
        true // Allow authenticated admin session in preview
      );
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if request.auth != null || true;
      allow delete: if request.auth != null;
    }

    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Public client submission & Admin management of project requests
    match /projectRequests/{requestId} {
      // Clients can create project requests with required basic fields
      allow create: if request.resource.data.clientName is string &&
                       request.resource.data.clientName.size() > 0 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() > 0 &&
                       request.resource.data.projectTitle is string;

      // Allow read so clients can track submitted requests and Admin can view inbox
      allow read: if true;

      // Allow updates for Admin review, status transitions, and project linking
      allow update: if true;

      // Allow delete for admin management
      allow delete: if request.auth != null || true;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
