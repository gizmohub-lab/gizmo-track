{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Client design project records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "clientName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "clientName"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Tax invoices and payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "grandTotal"]
    },
    "ProjectRequest": {
      "title": "ProjectRequest",
      "description": "Client project brief and commission requests submitted via Start a Project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "requestNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "companyName": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "projectTitle": { "type": "string" },
        "services": { "type": "array" },
        "description": { "type": "string" },
        "budgetRange": { "type": "string" },
        "timelineOption": { "type": "string" },
        "requestStatus": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "clientName", "email", "projectTitle", "requestStatus"]
    },
    "PublicSiteWork": {
      "title": "PublicSiteWork",
      "description": "Showcase portfolio and case study items displayed on the public site",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "clientName": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isVisible": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "orderIndex": { "type": "number" }
      },
      "required": ["id", "title", "category"]
    },
    "PublicSiteTeamMember": {
      "title": "PublicSiteTeamMember",
      "description": "Studio team members displayed on the public about view",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "displayOrder": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["id", "name", "role", "bio"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects collection"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Invoices collection"
    },
    "/projectRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ProjectRequest" },
      "description": "Client commission requests collection"
    },
    "/publicSiteWork/{workId}": {
      "schema": { "$ref": "#/entities/PublicSiteWork" },
      "description": "Portfolio work items collection"
    },
    "/publicSiteTeam/{memberId}": {
      "schema": { "$ref": "#/entities/PublicSiteTeamMember" },
      "description": "Studio team members collection"
    }
  }
}
